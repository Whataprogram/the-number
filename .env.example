# Optional cloud configuration. Without these values, local records and the sample still work.
# Copy this file to .env.local for development. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public signup/recovery is deliberately deferred for the private pilot.
# Enable only after custom SMTP, redirects and non-team delivery are tested.
NEXT_PUBLIC_ENABLE_EMAIL_SIGNUP=false

# Exact application origin. Match the hostname AND port you actually open.
# Production example: https://your-number-project.vercel.app
APP_URL=http://localhost:3000

# Public values are embedded by Next.js at build time; rebuild after changing them.
# Preview deployments need their own allowed origin and an isolated test database.
# Do not put database passwords, service-role keys, secret keys or SMTP credentials here.
# SMTP belongs in Supabase Auth settings; keep email verification enabled.
